# Neon: koneksi pooled untuk runtime aplikasi.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/silk?sslmode=require&connect_timeout=15"

# Neon: koneksi langsung untuk migration, introspection, dan seed.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/silk?sslmode=require"

# Aplikasi
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET=""
# Masa simpan log aktivitas pengguna (login, pesanan, dst.), dalam hari. Default 90.
AUDIT_ACTIVITY_RETENTION_DAYS="90"
AUTH_URL="http://localhost:3000"
AUTH_SECRET="ganti-dengan-openssl-rand-base64-32"

# Rate limit bersama (opsional; tanpa ini memakai in-memory per instance)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Email (opsional di development; tanpa ini email ditulis ke console)
RESEND_API_KEY=""
EMAIL_FROM="SILK <no-reply@domain-anda.com>"

# Midtrans (opsional; tanpa server key endpoint pembayaran mengembalikan 503)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# AI (opsional; struktur provider disiapkan, integrasi belum aktif)
AI_PROVIDER="unavailable"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
AI_TIMEOUT_MS="30000"

# Cloudinary (opsional; tanpa ini endpoint signature upload mengembalikan 503)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_IMAGE_PRESET=""
CLOUDINARY_VIDEO_PRESET=""

# Seed admin
SEED_ADMIN_NAME="Admin SILK"
SEED_ADMIN_EMAIL="admin@silk.local"
SEED_ADMIN_PASSWORD="ganti-password-ini"

# Seed data demo (opsional)
SEED_DEMO_PASSWORD="Demo12345!"

# Akun uji panel (npm run db:seed:test). Hanya untuk pengembangan lokal; seed menolak jalan di
# production. Isi password sendiri di .env (minimal 8 karakter).
# TEST_FACILITY = klinik (menu tanpa pesanan/produk), TEST_PHARMACY = apotek (dengan pesanan/produk).
TEST_DOCTOR_EMAIL="test-dokter@silk.local"
TEST_DOCTOR_PASSWORD=""
TEST_FACILITY_EMAIL="test-fasilitas@silk.local"
TEST_FACILITY_PASSWORD=""
TEST_PHARMACY_EMAIL="test-apotek@silk.local"
TEST_PHARMACY_PASSWORD=""
TEST_PATIENT_EMAIL="test-pengguna@silk.local"
TEST_PATIENT_PASSWORD=""
