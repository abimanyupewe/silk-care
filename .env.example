# Neon: koneksi pooled untuk runtime aplikasi.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/silk?sslmode=require&connect_timeout=15"

# Neon: koneksi langsung untuk migration, introspection, dan seed.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/silk?sslmode=require"

# Aplikasi
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
AUTH_SECRET="ganti-dengan-openssl-rand-base64-32"

# Seed admin
SEED_ADMIN_NAME="Admin SILK"
SEED_ADMIN_EMAIL="admin@silk.local"
SEED_ADMIN_PASSWORD="ganti-password-ini"
